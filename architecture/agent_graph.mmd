	analyze --> recommend;
	classify -.-> finalize;
	classify -.-> retrieve;
	gate -.-> classify;
	gate -.-> rules;
	gather_evidence -.-> analyze;
	gather_evidence -.-> reduced;
	judge -.-> analyze;
	judge -.-> finalize;
	judge -.-> recommend;
	recommend --> judge;
	reduced --> finalize;
	retrieve --> gather_evidence;
	rules -.-> finalize;
	rules -.-> retrieve;
	finalize --> __end__;
