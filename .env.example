# Copy to .env and fill in secrets. Never commit .env.

# Runtime LLM provider: aicredits (default: Claude Haiku 5.5 via the AICredits gateway, for development and testing)
# | anthropic (Claude direct, e.g. for the demo) | openai_compatible (NVIDIA rollback) | none (reduced mode).
LLM_PROVIDER=aicredits
# AICredits (aicredits.in): prepaid INR credits, OpenAI-compatible. Model IDs are provider-prefixed.
AICREDITS_API_KEY=
AICREDITS_MODEL=anthropic/claude-haiku-5.5
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
# Claude thinking: reasoning ON -> adaptive at this effort; reasoning OFF -> between_tools at ANTHROPIC_EFFORT.
ANTHROPIC_EFFORT_REASONING=medium
ANTHROPIC_EFFORT=low
ANTHROPIC_REFUSAL_FALLBACK=true
# OpenAI-compatible endpoint (NVIDIA API catalog): used when LLM_PROVIDER=openai_compatible, and by the eval judge.
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
# nvapi-... key. LLM_API_KEY is also accepted.
NVIDIA_API_KEY=
LLM_MODEL=nvidia/nemotron-3-super-120b-a12b
JUDGE_LLM_MODEL=
# NVIDIA free tier: about 40 requests/minute per account, shared by all models.
LLM_RPM_LIMIT=35
# Reasoning models: thinking on/off, and extra max_tokens reserved for the hidden reasoning.
LLM_REASONING=true
LLM_REASONING_ALLOWANCE=2048
# Per-agent reasoning (Phase 8, option B): classifier/recommender off, analyst/judge on.
CLASSIFIER_REASONING=false
ANALYST_REASONING=true
RECOMMENDER_REASONING=false
JUDGE_REASONING=true
AGENT_REASONING_ALLOWANCE=4096
# Per /troubleshoot run: hard caps on LLM calls (repairs count) and tokens (reasoning counts).
MAX_LLM_CALLS_PER_RUN=12
MAX_TOKENS_PER_RUN=50000
# Daily cap on estimated Claude + AICredits spend (USD, UTC day; app + evaluation scripts). When reached, requests run in
# reduced (no-LLM) mode until the next UTC day. Check usage: python -m scripts.spend_report
LLM_DAILY_BUDGET_USD=1.00

# Independent evaluation judge (DeepEval, troubleshoot re-score), separate from the runtime judge.
# Default openai/gpt-oss-120b via AICredits: a different model family from the Claude agents (independent judge).
# Phase 11 used EVAL_LLM_PROVIDER=anthropic, EVAL_LLM_MODEL=claude-opus-5-5.
EVAL_LLM_PROVIDER=aicredits
EVAL_LLM_MODEL=openai/gpt-oss-120b
EVAL_LLM_EFFORT=medium
# Empty -> the evaluation provider's key; EVAL_LLM_BASE_URL is used only with openai_compatible.
EVAL_LLM_BASE_URL=
EVAL_LLM_API_KEY=

# Retrieval and data (DATA_SOURCE: sample | full)
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
DATA_SOURCE=full
TOP_K=5

# Frontend
API_BASE_URL=http://localhost:8000
# Full AI /troubleshoot baseline: median 103 s, p95 162 s, max 177 s (Phase 8); 240 s leaves headroom.
UI_TIMEOUT_S=240

# Windows and telemetry noise
HF_HUB_DISABLE_SYMLINKS_WARNING=1
DEEPEVAL_TELEMETRY_OPT_OUT=YES
ANONYMIZED_TELEMETRY=False
